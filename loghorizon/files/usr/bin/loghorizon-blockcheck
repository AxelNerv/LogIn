#!/bin/sh
# Safely compares DPI strategies on the router and always restores the saved one.

set -eu

SECTION=""
FILE=""
HOSTS="discord.com,www.youtube.com"
COUNT=8
SETTLE=22
CONTROL_URL="${LOGHORIZON_BLOCKCHECK_CONTROL_URL:-https://connectivitycheck.gstatic.com/generate_204}"
LOCK_DIR="${LOGHORIZON_BLOCKCHECK_LOCK_DIR:-/var/run/loghorizon-blockcheck.lock}"
UCI_BIN="${LOGHORIZON_BLOCKCHECK_UCI_BIN:-uci}"
SERVICE_INIT="${LOGHORIZON_BLOCKCHECK_SERVICE_INIT:-/etc/init.d/loghorizon}"
CURL_BIN="${LOGHORIZON_BLOCKCHECK_CURL_BIN:-curl}"
PGREP_BIN="${LOGHORIZON_BLOCKCHECK_PGREP_BIN:-pgrep}"
SLEEP_BIN="${LOGHORIZON_BLOCKCHECK_SLEEP_BIN:-sleep}"
RESTORE_NEEDED=0
ORIGINAL=""
ORIGINAL_PRESENT=0
OPTION=""
ENGINE=""

usage() {
    printf '%s\n' \
        'Usage: loghorizon-blockcheck -s <section> -f <file> [-t hosts] [-n count]' \
        '  -s  DPI section name' \
        '  -f  TAB-separated file: name, strategy' \
        '  -t  comma-separated HTTPS hosts' \
        '  -n  requests per host (minimum 8)' \
        '  -w  settle time after restart (minimum 20 seconds)' \
        '  -c  neutral connectivity-check URL'
}

fail() {
    printf 'BlockCheck: %s\n' "$1" >&2
    exit 1
}

valid_uint() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -s) [ "$#" -ge 2 ] || fail '-s requires a value'; SECTION="$2"; shift 2 ;;
        -f) [ "$#" -ge 2 ] || fail '-f requires a value'; FILE="$2"; shift 2 ;;
        -t) [ "$#" -ge 2 ] || fail '-t requires a value'; HOSTS="$2"; shift 2 ;;
        -n) [ "$#" -ge 2 ] || fail '-n requires a value'; COUNT="$2"; shift 2 ;;
        -w) [ "$#" -ge 2 ] || fail '-w requires a value'; SETTLE="$2"; shift 2 ;;
        -c) [ "$#" -ge 2 ] || fail '-c requires a value'; CONTROL_URL="$2"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) fail "unknown argument: $1" ;;
    esac
done

[ -n "$SECTION" ] || fail 'a section is required'
case "$SECTION" in *[!A-Za-z0-9_-]*) fail 'invalid section name' ;; esac
[ -n "$FILE" ] || fail 'a strategy file is required'
[ -r "$FILE" ] || fail "cannot read $FILE"
[ -n "$HOSTS" ] || fail 'at least one test host is required'
valid_uint "$COUNT" || fail 'request count must be an integer'
[ "$COUNT" -ge 8 ] || fail 'request count below 8 is not reliable'
[ "$COUNT" -le 30 ] || fail 'request count above 30 is not allowed'
valid_uint "$SETTLE" || fail 'settle time must be an integer'
[ "$SETTLE" -ge 20 ] || fail 'settle time below 20 seconds is not reliable'
[ "$SETTLE" -le 120 ] || fail 'settle time above 120 seconds is not allowed'
case "$CONTROL_URL" in https://*) ;; *) fail 'connectivity-check URL must use HTTPS' ;; esac

ACTION="$("$UCI_BIN" -q get "loghorizon.$SECTION.action")" || fail "section $SECTION does not exist"
case "$ACTION" in
    zapret) OPTION="nfqws_opt"; ENGINE="nfqws" ;;
    zapret2) OPTION="nfqws2_opt"; ENGINE="nfqws2" ;;
    byedpi) OPTION="byedpi_cmd_opts"; ENGINE="ciadpi" ;;
    *) fail "section $SECTION does not use a DPI engine" ;;
esac

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    fail 'another BlockCheck is already running'
fi

if ORIGINAL="$("$UCI_BIN" -q get "loghorizon.$SECTION.$OPTION")"; then
    ORIGINAL_PRESENT=1
fi

restore_original() {
    [ "$RESTORE_NEEDED" -eq 1 ] || return 0

    if [ "$ORIGINAL_PRESENT" -eq 1 ]; then
        "$UCI_BIN" set "loghorizon.$SECTION.$OPTION=$ORIGINAL" || return 1
    else
        "$UCI_BIN" -q delete "loghorizon.$SECTION.$OPTION" || {
            [ "$?" -eq 1 ] || return 1
        }
    fi
    "$UCI_BIN" commit loghorizon || return 1
    "$SERVICE_INIT" restart >/dev/null 2>&1 || return 1
    RESTORE_NEEDED=0
}

cleanup() {
    _status="$?"
    trap - EXIT INT TERM HUP
    if ! restore_original; then
        printf 'BlockCheck: CRITICAL: failed to restore the original strategy\n' >&2
        _status=1
    fi
    if ! rmdir "$LOCK_DIR" 2>/dev/null; then
        printf 'BlockCheck: failed to release test lock %s\n' "$LOCK_DIR" >&2
        _status=1
    fi
    exit "$_status"
}
trap cleanup EXIT INT TERM HUP

connectivity_ok() {
    _attempt=0
    while [ "$_attempt" -lt 2 ]; do
        if "$CURL_BIN" -sS --fail -o /dev/null --connect-timeout 4 --max-time 8 "$CONTROL_URL"; then
            return 0
        fi
        _attempt=$((_attempt + 1))
    done
    return 1
}

probe_host() {
    _host="$1"
    _ok=0
    _total_ms=0
    _attempt=0

    while [ "$_attempt" -lt "$COUNT" ]; do
        _seconds="$("$CURL_BIN" -sS --fail -o /dev/null --connect-timeout 3 --max-time 6 \
            -w '%{time_total}' "https://$_host/favicon.ico" 2>/dev/null)" || _seconds=""
        if [ -n "$_seconds" ]; then
            _ms="$(awk -v value="$_seconds" 'BEGIN { printf "%d", value * 1000 }')" || return 1
            _total_ms=$((_total_ms + _ms))
            _ok=$((_ok + 1))
        fi
        _attempt=$((_attempt + 1))
    done

    if [ "$_ok" -gt 0 ]; then
        _average_ms=$((_total_ms / _ok))
        printf '%s/%s avg=%sms' "$_ok" "$COUNT" "$_average_ms"
    else
        printf '0/%s avg=n/a' "$COUNT"
    fi
}

printf 'BlockCheck: section=%s engine=%s requests=%s settle=%ss hosts=%s\n' \
    "$SECTION" "$ACTION" "$COUNT" "$SETTLE" "$HOSTS"

while IFS="$(printf '\t')" read -r name strategy; do
    [ -n "$name" ] || continue
    case "$name" in \#*) continue ;; esac
    [ -n "$strategy" ] || {
        printf '%-30s rejected: empty strategy\n' "$name"
        continue
    }

    RESTORE_NEEDED=1
    if ! "$UCI_BIN" set "loghorizon.$SECTION.$OPTION=$strategy" ||
       ! "$UCI_BIN" commit loghorizon; then
        fail "failed to save candidate $name"
    fi

    if ! "$SERVICE_INIT" restart >/dev/null 2>&1; then
        printf '%-30s rejected: service refused to restart\n' "$name"
        restore_original || fail 'failed to restore after rejected strategy'
        continue
    fi

    "$SLEEP_BIN" "$SETTLE"

    if ! "$PGREP_BIN" -x "$ENGINE" >/dev/null 2>&1; then
        printf '%-30s rejected: engine did not start\n' "$name"
        restore_original || fail 'failed to restore after engine failure'
        continue
    fi

    if ! connectivity_ok; then
        printf '%-30s rolled back: external connectivity was lost\n' "$name"
        restore_original || fail 'failed to restore after connectivity loss'
        continue
    fi

    _line="$(printf '%-30s' "$name")"
    for host in $(printf '%s' "$HOSTS" | tr ',' ' '); do
        case "$host" in *[!A-Za-z0-9.-]*|'') fail "invalid test host: $host" ;; esac
        _line="$_line $host=$(probe_host "$host")"
    done
    printf '%s\n' "$_line"
done < "$FILE"

restore_original || fail 'failed to restore the original strategy'
printf 'BlockCheck: original strategy restored successfully\n'
